<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>false</InvariantGlobalization>
        <LangVersion>14.0</LangVersion>
        <Version>0.1.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14"/>
        <PackageReference Include="Scalar.AspNetCore" Version="2.18.7"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14"/>
        <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.12"/>
        <PackageReference Include="Humanizer" Version="3.0.10"/>
        <PackageReference Include="Cortex.Mediator" Version="3.1.2"/>
        <!-- BCrypt Encryption related packages -->
        <PackageReference Include="BCrypt.Net-Next" Version="4.2.0"/>
        <!-- JSON Web Token related packages -->
        <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
        <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Iam\Resources\IamMessages.es.resx">
            <DependentUpon>IamMessages.cs</DependentUpon>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Settings\Application\" />
      <Folder Include="Settings\Domain\" />
      <Folder Include="Settings\Infrastructure\Persistence\EntityFrameworkCore\" />
      <Folder Include="Settings\Interfaces\" />
      <Folder Include="Settings\Resources\" />
    </ItemGroup>

</Project>
